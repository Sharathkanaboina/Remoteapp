<Window x:Class="RemoteAdminClientUI.ConsentDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Consent" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Name="Accept" Click="Accept_Click" Padding="10,5" Margin="0,0,10,0">Accept</Button>

            <Button Name="Decline" Click="Decline_Click" Padding="10,5">Decline</Button>

        </StackPanel>

    </StackPanel>

</Window>