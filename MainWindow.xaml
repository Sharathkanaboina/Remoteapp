<Window x:Class="RemoteAdminClientUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Admin App" Height="350" Width="500">

    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Remote Admin Client" FontSize="18" FontWeight="Bold"/>

            <TextBlock x:Name="StatusText" Text="Not connected" Margin="0,10,0,0"/>

            <Button x:Name="ConnectButton" Content="Connect" Width="100" Click="ConnectButton_Click"/>

            <Separator Margin="0,20,0,20"/>

            <TextBlock Text="Active Session:" FontWeight="Bold"/>
            <TextBlock x:Name="SessionText" Text="(none)" Margin="0,5,0,0"/>

            <Separator Margin="0,20,0,20"/>

            <TextBlock Text="Log:"/>
            <TextBox x:Name="LogBox" Height="120" VerticalScrollBarVisibility="Auto"/>

        </StackPanel>
    </Grid>
</Window>
